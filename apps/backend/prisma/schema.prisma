generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TMDBMovie {
  id           Int         @id @default(autoincrement())
  tmdb_id      Int         @unique
  overview     String?
  poster_path  String?
  createdAt    DateTime    @default(now())
  popularity   Float?
  release_date DateTime?
  title        String
  vote_average Float?
  vote_count   Int?
  favourites   Favourite[]
  reviews      Review[]
}

model Favourite {
  id        Int       @id @default(autoincrement())
  userId    String
  movieId   Int
  createdAt DateTime  @default(now())
  movie     TMDBMovie @relation(fields: [movieId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}

model User {
  id         String      @id
  email      String?     @unique
  password   String?
  createdAt  DateTime    @default(now())
  favourites Favourite[]
  reviews    Review[]
}

model Review {
  id        Int       @id @default(autoincrement())
  userId    String
  movieId   Int
  rating    Int
  comment   String
  createdAt DateTime  @default(now())
  movie     TMDBMovie @relation(fields: [movieId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, movieId])
}
